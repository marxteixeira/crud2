{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "O",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "Supabase": {
    "Url": "",
    "Audience": "authenticated"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  }
}
